{
  "name": "@thorvg/webcanvas",
  "version": "1.0.2",
  "description": "A TypeScript WebCanvas API for ThorVG - High-performance vector graphics rendering",
  "main": "./dist/webcanvas.cjs.js",
  "module": "./dist/webcanvas.esm.js",
  "types": "./dist/webcanvas.d.ts",
  "exports": {
    ".": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/webcanvas.esm.js",
      "require": "./dist/webcanvas.cjs.js"
    },
    "./sw": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/sw/webcanvas.esm.js",
      "require": "./dist/sw/webcanvas.cjs.js"
    },
    "./gl": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/gl/webcanvas.esm.js",
      "require": "./dist/gl/webcanvas.cjs.js"
    },
    "./wg": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/wg/webcanvas.esm.js",
      "require": "./dist/wg/webcanvas.cjs.js"
    },
    "./sw-lite": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/sw-lite/webcanvas.esm.js",
      "require": "./dist/sw-lite/webcanvas.cjs.js"
    },
    "./gl-lite": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/gl-lite/webcanvas.esm.js",
      "require": "./dist/gl-lite/webcanvas.cjs.js"
    },
    "./wg-lite": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/wg-lite/webcanvas.esm.js",
      "require": "./dist/wg-lite/webcanvas.cjs.js"
    },
    "./pthread": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/pthread/webcanvas.esm.js",
      "require": "./dist/pthread/webcanvas.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "!dist/thorvg.d.ts",
    "!dist/thorvg.js",
    "!dist/sw/thorvg.js",
    "!dist/gl/thorvg.js",
    "!dist/wg/thorvg.js",
    "!dist/sw-lite/thorvg.js",
    "!dist/gl-lite/thorvg.js",
    "!dist/wg-lite/thorvg.js"
  ],
  "scripts": {
    "build": "npm run clean && sh ./wasm_wcanvas_setup.sh && THORVG_VERSION=$(npm run version --silent) rollup -c --bundleConfigAsCjs",
    "build:watch": "npm run clean && sh ./wasm_wcanvas_setup.sh && THORVG_VERSION=$(npm run version --silent) rollup -c --bundleConfigAsCjs --watch",
    "clean": "rm -rf dist && mkdir dist && touch dist/index.js",
    "test": "vitest run",
    "test:gl": "TEST_RENDERER=gl vitest run --config vitest.browser.config.ts",
    "test:wg": "TEST_RENDERER=wg vitest run --config vitest.browser.config.ts",
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "docs": "typedoc && node ./tools/docs/generate.js",
    "docs:watch": "typedoc --watch",
    "docs:serve": "typedoc --watch --serve",
    "version": "sed -n -e 4p ../../thorvg/meson.build | sed 's/..$//' | sed -r 's/.{19}//'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorvg/thorvg.web.git",
    "directory": "packages/webcanvas"
  },
  "author": "Jinny You <jinny@lottiefiles.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thorvg/thorvg.web/issues"
  },
  "homepage": "https://thorvg.org",
  "keywords": [
    "thorvg",
    "canvas",
    "vector graphics",
    "webgpu",
    "webgl",
    "wasm",
    "2d graphics"
  ],
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@swc/core": "^1.3.99",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^8.0.1",
    "happy-dom": "^20.5.0",
    "playwright": "^1.58.2",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-swc3": "^0.10.4",
    "rollup-plugin-terser": "^7.0.2",
    "typedoc": "^0.28.15",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "typescript": "*",
    "vitest": "^4.0.18"
  }
}
